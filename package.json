{
	"name": "penguin-push",
	"version": "0.1.0",
	"private": true,
	"description": "Penguin Push — a 3D penguin sumo party game for up to 4 players",
	"type": "module",
	"scripts": {
		"dev": "serve public -l 3000",
		"dev:relay": "node relay/node-server.js",
		"eslint": "eslint --report-unused-disable-directives --max-warnings 0",
		"lint": "npm run eslint -- \"public/**/*.{js,html}\" \"tests/**/*.js\" \"scripts/**/*.js\" \"relay/**/*.js\" \"*.js\"",
		"lint:fix": "npm run lint -- --fix",
		"format": "prettier --write \"public/**/*.css\" \"*.{js,json}\" && npm run lint:fix",
		"typecheck": "tsc --noEmit -p jsconfig.json",
		"net:sync": "node scripts/sync-netplay.js",
		"net:check": "node scripts/sync-netplay.js --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test --trace off",
		"check": "npm run lint && npm run typecheck && npm run net:check && npm run test && npm run test:e2e",
		"build": "node scripts/build.js",
		"deploy": "npm run build && netlify deploy --prod --dir=dist"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.6",
		"@types/three": "^0.187.0",
		"@types/ws": "^8.18.2",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-html": "^8.2.1",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^15.15.0",
		"html-minifier-terser": "^7.2.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.10.1",
		"serve": "^14.2.8",
		"three": "^0.187.0",
		"typescript": "^5.9.3",
		"vitest": "^5.1.1",
		"ws": "^8.23.0"
	}
}
